{
  // Cloudflare Workers static-assets deployment.
  // Having this file stops `wrangler deploy` from running its auto-config step
  // (which installs packages and rewrites vite.config.js during the deploy).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-nativo-gardens",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
